{
  "schemaVersion": 1,
  "note": "多团队 DESIGN §12 索引逻辑清单。含 clubId 的索引一律以 clubId 为前缀。唯一/方向/复合/稀疏支持须 P0 实测；不写不被数据库接受的索引定义。_id 是否可加入复合索引待验证。",
  "indexes": [
    { "collection": "rak_members", "name": "members_by_user", "keys": [{ "field": "userId", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false, "purpose": "本人选队（team.listMine）" },
    { "collection": "rak_members", "name": "members_by_club_status", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "createdAt", "order": "asc" }, { "field": "_id", "order": "asc" }], "unique": false, "purpose": "名册/成员管理" },
    { "collection": "rak_members", "name": "members_by_club_role_status", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "role", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "createdAt", "order": "asc" }, { "field": "_id", "order": "asc" }], "unique": false, "purpose": "角色筛选/任免" },
    { "collection": "rak_members", "name": "members_unique_team", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "userId", "order": "asc" }], "unique": true, "purpose": "同人每队至多一个（确定性主键外的唯一防线，主防线仍为 _id=hash）" },
    { "collection": "rak_identities", "name": "identities_owner_reference", "keys": [{ "field": "ownerReferenceHash", "order": "asc" }], "unique": true, "sparse": true, "purpose": "受控参考号 hash 查找；仅对有值记录。稀疏/部分索引支持待 P0 验证" },
    { "collection": "rak_tasks", "name": "tasks_by_club_created", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false },
    { "collection": "rak_tasks", "name": "tasks_by_club_status", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false },
    { "collection": "rak_tasks", "name": "tasks_by_club_assignee", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "assigneeMemberId", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false },
    { "collection": "rak_task_submissions", "name": "submissions_by_club_task_round", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "taskId", "order": "asc" }, { "field": "round", "order": "desc" }], "unique": false, "purpose": "同 task+round 逻辑唯一" },
    { "collection": "rak_announcements", "name": "announcements_by_club_status_pinned", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "pinned", "order": "desc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false },
    { "collection": "rak_announcements", "name": "announcements_by_club_pinned", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "pinned", "order": "desc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false, "purpose": "manager 不筛 status 的对应索引" },
    { "collection": "rak_roi_items", "name": "roi_by_club_deleted_date", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "deletedAt", "order": "asc" }, { "field": "accountingDate", "order": "asc" }], "unique": false },
    { "collection": "rak_roi_items", "name": "roi_by_club_deleted_status", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "deletedAt", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false },
    { "collection": "rak_invites", "name": "invites_code_hash", "keys": [{ "field": "codeHash", "order": "asc" }], "unique": true, "purpose": "码全局唯一" },
    { "collection": "rak_invites", "name": "invites_scene_token_hash", "keys": [{ "field": "sceneTokenHash", "order": "asc" }], "unique": true, "sparse": true, "purpose": "scene 全局唯一。**sparse 只排除字段缺失，null 会被索引**：未启用小程序码时必须省略该字段，禁止写 null（否则第二条邀请码即唯一冲突）" },
    { "collection": "rak_invites", "name": "invites_by_club_created", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false },
    { "collection": "rak_join_entries", "name": "join_entries_key_hash", "keys": [{ "field": "keyHash", "order": "asc" }], "unique": true, "purpose": "申请入口 hash 唯一" },
    { "collection": "rak_join_requests", "name": "join_requests_by_club_status", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false },
    { "collection": "rak_join_requests", "name": "join_requests_by_user", "keys": [{ "field": "userId", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false, "purpose": "join.mine（账户级）" },
    { "collection": "rak_club_applications", "name": "club_applications_by_club_status", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false, "purpose": "本队开队待审列表" },
    { "collection": "rak_club_applications", "name": "club_applications_by_applicant", "keys": [{ "field": "applicantUserId", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false, "purpose": "我的开通申请（账户级）" },
    { "collection": "rak_member_dismissals", "name": "dismissals_by_club_status", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "status", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false, "purpose": "本队裁员待审列表" },
    { "collection": "rak_member_dismissals", "name": "dismissals_by_target", "keys": [{ "field": "targetMemberId", "order": "asc" }, { "field": "createdAt", "order": "desc" }], "unique": false, "purpose": "按目标成员定位申请" },
    { "collection": "rak_club_dissolutions", "name": "dissolutions_by_status", "keys": [{ "field": "status", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false, "purpose": "超管跨队协助解散待办（GLOBAL）" },
    { "collection": "rak_club_dissolutions", "name": "dissolutions_by_club", "keys": [{ "field": "clubId", "order": "asc" }], "unique": true, "purpose": "每队至多一条申请（确定性 _id 的第二道防线）" },
    { "collection": "rak_clubs", "name": "clubs_slug_unique", "keys": [{ "field": "slug", "order": "asc" }], "unique": true, "purpose": "新队 slug 全局唯一（并发审批最终防线）；需云侧创建后生效" },
    { "collection": "rak_clubs", "name": "clubs_display_code_unique", "keys": [{ "field": "displayCode", "order": "asc" }], "unique": true, "purpose": "新队展示码全局唯一；需云侧创建后生效" },
    { "collection": "rak_upload_sessions", "name": "sessions_by_member_state_expiry", "keys": [{ "field": "uploaderMemberId", "order": "asc" }, { "field": "state", "order": "asc" }, { "field": "uploadExpiresAt", "order": "asc" }], "unique": false },
    { "collection": "rak_upload_sessions", "name": "sessions_by_state_confirmed_until", "keys": [{ "field": "state", "order": "asc" }, { "field": "confirmedUntil", "order": "asc" }], "unique": false },
    { "collection": "rak_upload_credentials", "name": "credentials_by_session_cleanup", "keys": [{ "field": "sessionId", "order": "asc" }, { "field": "cleanupNotBefore", "order": "asc" }], "unique": false },
    { "collection": "rak_storage_attempts", "name": "attempts_by_session_state", "keys": [{ "field": "sessionId", "order": "asc" }, { "field": "state", "order": "asc" }], "unique": false },
    { "collection": "rak_storage_attempts", "name": "attempts_by_state_updated", "keys": [{ "field": "state", "order": "asc" }, { "field": "updatedAt", "order": "asc" }], "unique": false },
    { "collection": "rak_upload_chunks", "name": "chunks_unique", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "sessionId", "order": "asc" }, { "field": "index", "order": "asc" }], "unique": true, "deployWhen": "仅选定 function-chunks-v1 时" },
    { "collection": "rak_attachments", "name": "attachments_by_club_task_submission", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "taskId", "order": "asc" }, { "field": "submissionId", "order": "asc" }], "unique": false },
    { "collection": "rak_attachments", "name": "attachments_by_lifecycle_created", "keys": [{ "field": "lifecycleState", "order": "asc" }, { "field": "createdAt", "order": "asc" }], "unique": false },
    { "collection": "rak_commands", "name": "commands_by_retain_until", "keys": [{ "field": "retainUntil", "order": "asc" }], "unique": false, "purpose": "过期清理" },
    { "collection": "rak_jobs", "name": "jobs_by_state_run_after", "keys": [{ "field": "state", "order": "asc" }, { "field": "runAfter", "order": "asc" }], "unique": false, "purpose": "仅系统后台" },
    { "collection": "rak_audit_events", "name": "audit_by_club_created", "keys": [{ "field": "clubId", "order": "asc" }, { "field": "createdAt", "order": "desc" }, { "field": "_id", "order": "desc" }], "unique": false }
  ]
}
