{
  "name": "rak-control",
  "version": "1.0.0",
  "private": true,
  "description": "Rak — 学校社团内部应用与团队 ROI 管理",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "build:weapp": "taro build --type weapp --mode development",
    "build:weapp:prod": "taro build --type weapp --mode production",
    "dev:weapp": "npm run build:weapp -- --watch",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:server": "node --experimental-strip-types --test server/tests/*.test.ts",
    "build:cloud": "node scripts/build-cloud.mjs",
    "verify:cloud:artifacts": "node scripts/verify-cloud-artifacts.mjs",
    "verify:cloud:config": "node scripts/verify-cloud-config.mjs",
    "verify:no-client-db": "node scripts/verify-no-client-db.mjs",
    "verify:client:cloud": "node scripts/verify-client-cloud.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:cloud:integration": "node scripts/cloud-integration/run.mjs"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@taroify/core": "^1.0.6",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-generator": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/minimatch": "^5",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.2.1",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  }
}
